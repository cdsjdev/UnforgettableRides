# ============================================================
# UnforgettableRides Production Environment
# Copy to .env and fill in all REQUIRED values before starting
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Set to 1 or "loopback" when behind a reverse proxy (e.g. Lightsail load balancer)
TRUST_PROXY=1
# Comma-separated list of allowed CORS origins (leave empty to allow all — NOT recommended)
# Example: https://admin.yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=

# ── Authentication (REQUIRED) ──────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_MIN=30
# Example: https://dashboard.yourdomain.com
PASSWORD_RESET_BASE_URL=
# Webhook endpoint that sends transactional emails (including reset links)
EMAIL_NOTIFICATION_WEBHOOK_URL=

# ── Initial Admin User (REQUIRED on first run) ─────────────
ADMIN_EMAIL=admin@unforgettablerides.com
ADMIN_PASSWORD=

# ── Internal Service Auth (REQUIRED) ───────────────────────
# Shared key between API and ML service for HMAC-signed requests
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=
# Max age for HMAC timestamps (ms). Default 5 min.
INTERNAL_HMAC_MAX_AGE_MS=300000

# ── Database ────────────────────────────────────────────────
# Path for the analytics SQLite database (inside container)
ANALYTICS_DB_PATH=/app/db/analytics.db

# ── ML Service ──────────────────────────────────────────────
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_ENABLED=true
ML_SERVICE_TIMEOUT=10000

# ── AI Advisor (optional — at least one key enables the feature)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# Provider priority and defaults
ADVISOR_PROVIDER_ORDER=claude,chatgpt,gemini
ADVISOR_DEFAULT_PROVIDER=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# ── Camera Worker (optional) ───────────────────────────────
CAMERA_URL=
ENABLE_TRACKING=1
DOOR_LINE_COORDS=
DOOR_LINE_DIRECTION=
CAMERA_CAPTURE_INTERVAL=2
CAMERA_FRAME_WIDTH=640
CAMERA_FRAME_HEIGHT=480
DOG_DETECTION_CONFIDENCE=0.4
API_CALLBACK_URL=http://rides-api:3000/api/v1/analytics/detection

# ── Docker Compose Ports ───────────────────────────────────
API_PORT=3000
WEB_PORT=8080
APP_WEB_PORT=8081

