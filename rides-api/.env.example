# UnforgettableRides API Environment Configuration
# Copy this file to .env and update values as needed

# Server
PORT=3000
NODE_ENV=development

# API
API_VERSION=v1

# ML Service Configuration
ML_SERVICE_URL=http://localhost:8000  # URL of the Python ML service
ML_SERVICE_ENABLED=true               # Set to 'false' to use mock predictions only
ML_SERVICE_TIMEOUT=10000              # Timeout in milliseconds for ML requests

# AI Advisor - LLM API Keys (configure at least one for the Advisor feature)
ANTHROPIC_API_KEY=                    # Anthropic Claude API key (sk-ant-...)
OPENAI_API_KEY=                       # OpenAI ChatGPT API key (sk-...)
GOOGLE_AI_API_KEY=                    # Google Gemini API key (AIza...)

# AI Advisor - Provider and model selection (optional)
ADVISOR_PROVIDER_ORDER=claude,chatgpt,gemini   # Priority order when multiple keys are configured
ADVISOR_DEFAULT_PROVIDER=                       # Optional: force default (claude|chatgpt|gemini)
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# Stripe payment processing (optional — shop checkout disabled without these)
STRIPE_SECRET_KEY=                   # Stripe secret key (sk_test_... or sk_live_...)
STRIPE_PUBLISHABLE_KEY=              # Stripe publishable key (pk_test_... or pk_live_...)
STRIPE_WEBHOOK_SECRET=               # Stripe webhook signing secret (whsec_...)

# Notification webhooks (optional)
# If configured, UnforgettableRides will POST notification events to these endpoints.
# Payload includes: kind, channel, to, user_id, payload
# TODO(TEMP): Configure a real provider before production.
EMAIL_NOTIFICATION_WEBHOOK_URL=
SMS_NOTIFICATION_WEBHOOK_URL=

# SMTP email fallback (optional; used when EMAIL_NOTIFICATION_WEBHOOK_URL is empty or fails)
# TODO(TEMP): Configure SMTP credentials for real delivery in staging/production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM_NAME=UnforgettableRides
EMAIL_FROM_ADDRESS=
SETTINGS_ENCRYPTION_KEY=            # Optional but recommended for encrypting dashboard-saved secrets

# Public web app URL used by auth emails
PASSWORD_RESET_BASE_URL=http://localhost:5173
# Preferred public web app URL (used by dashboard + auth redirects)
PUBLIC_APP_BASE_URL=
# Optional override specifically for email verification link generation
EMAIL_VERIFY_BASE_URL=

