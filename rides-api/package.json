{
  "name": "rides-api",
  "version": "1.0.0",
  "description": "API for UnforgettableRides classic car marketplace",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles",
    "test:regression:payments-square": "jest --runInBand --forceExit --detectOpenHandles tests/payments-square.test.js",
    "test:regression:guest-public": "jest --runInBand --forceExit --detectOpenHandles tests/guest-public-routes.test.js",
    "test:regression:social": "jest --runInBand --forceExit --detectOpenHandles tests/social.test.js",
    "test:regression:social:flagged": "jest --runInBand --forceExit --detectOpenHandles tests/social.test.js -t \"auto-flagged|report submissions are rate limited per user|admin can read abuse stats\""
  },
  "dependencies": {
    "axios": "^1.6.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "stripe": "^21.0.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  }
}
