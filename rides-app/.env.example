# UnforgettableRides App Environment Configuration
# Copy this file to .env and update values as needed

# API Configuration
# For local development on simulator/emulator, use localhost
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# ML Service URL (dog breed detection)
EXPO_PUBLIC_ML_URL=http://localhost:8001

# For testing on physical device, use your computer's local IP
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api/v1
# Example: EXPO_PUBLIC_ML_URL=http://192.168.1.100:8001

# Environment
EXPO_PUBLIC_ENV=development

