{
  "name": "rides-app",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:navigation-regression": "node scripts/check-navigation-regression.js",
    "e2e": "playwright test e2e/tests/auth-nav.spec.ts e2e/tests/guest-mode-regression.spec.ts",
    "e2e:guest": "playwright test e2e/tests/guest-mode-regression.spec.ts --project=chromium",
    "e2e:guest:no-webserver": "playwright test --config=playwright.noweb.cjs e2e/tests/guest-mode-regression.spec.ts --project=chromium",
    "e2e:headed": "playwright test --headed",
    "e2e:no-webserver": "playwright test --config=playwright.noweb.cjs e2e/tests/auth-nav.spec.ts e2e/tests/guest-mode-regression.spec.ts",
    "e2e:install": "playwright install chromium",
    "web:e2e": "expo start --web --port 19006",
    "postinstall": "node scripts/patch-rnweb-font.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "axios": "^1.7.9",
    "expo": "~54.0.33",
    "expo-audio": "~1.1.1",
    "expo-av": "~16.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-image-viewing": "^0.2.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.58.2",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
